    "# for 2d \n",
    "\n",
    "def linear_combination(v1,v2,a,b):\n",
    "    return tuple(a*x+b*y for x,y in zip(v1,v2))\n",
    "linear_combination((3,2,5), (4,6,1), 2,3)\n"
